e\nimport os\nimport sys\nfrom pathlib import Path\n\n\ndef get_largest_files(directory: str, top_n: int = 10) -> list[tuple[str, int]]:\n    \"\"\"\n    Walk the directory tree and return the top_n largest files.\n    \n    Args:\n        directory: The root directory to search.\n        top_n: Number of largest files to return.\n        \n    Returns:\n        A list of tuples (filepath, size_in_bytes), sorted by size descending.\n    \"\"\"\n    file_sizes = []\n    \n    for root, dirs, files in os.walk(directory):\n        for filename in files:\n            filepath = os.path.join(root, filename)\n            try:\n                size = os.path.getsize(filepath)\n                file_sizes.append((filepath, size))\n            except (OSError, IOError):\n                # Skip files that can't be accessed\n                continue\n    \n    # Sort by size in descending order\n    file_sizes.sort(key=lambda x: x[1], reverse=True)\n    \n    return file_sizes[:top_n]\n\n\n", "client": {"ttft_s": 0.43768200000340585, "decode_s": 1.9558241999984602, "total_s": 2.3936570000005304, "n_gen": 256, "n_chunks": 256, "tg": 130.37981634555945, "pp": 77.68197001415508}}
