mport os\nimport sys\nfrom pathlib import Path\n\n\ndef get_largest_files(directory: str, top_n: int = 10) -> list[tuple[str, int]]:\n    \"\"\"\n    Walk the directory tree and return the top_n largest files.\n    \n    Args:\n        directory: Path to the root directory to search.\n        top_n: Number of largest files to return.\n    \n    Returns:\n        List of tuples (filepath, size_in_bytes), sorted by size descending.\n    \"\"\"\n    file_sizes = []\n    \n    for root, dirs, files in os.walk(directory):\n        for filename in files:\n            filepath = os.path.join(root, filename)\n            try:\n                size = os.path.getsize(filepath)\n                file_sizes.append((filepath, size))\n            except (OSError, IOError):\n                # Skip files that can't be accessed\n                continue\n    \n    # Sort by size descending, then by path for consistent ordering\n    file_sizes.sort(key=lambda x: (-x[1], x[0]))\n    \n   ", "client": {"ttft_s": 0.332294699997874, "decode_s": 2.6372525000042515, "total_s": 2.9697940000041854, "n_gen": 256, "n_chunks": 256, "tg": 96.69153787875409, "pp": 102.31881519692469}}
