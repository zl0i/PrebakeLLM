port os\nimport sys\nfrom pathlib import Path\n\n\ndef get_largest_files(directory: str, top_n: int = 10) -> list[tuple[str, int]]:\n    \"\"\"\n    Walk the directory tree and return the top_n largest files.\n\n    Args:\n        directory: The root directory to walk.\n        top_n: Number of largest files to return.\n\n    Returns:\n        A list of tuples (filepath, size_in_bytes), sorted by size descending.\n    \"\"\"\n    file_sizes: list[tuple[str, int]] = []\n\n    for root, dirs, files in os.walk(directory):\n        for filename in files:\n            filepath = os.path.join(root, filename)\n            try:\n                size = os.path.getsize(filepath)\n                file_sizes.append((filepath, size))\n            except OSError:\n                # Skip files that can't be accessed\n                continue\n\n    # Sort by size descending, then by path for deterministic ordering\n    file_sizes.sort(key=lambda x: (-x[1], x[0]))\n\n    return", "client": {"ttft_s": 0.402317200001562, "decode_s": 2.02881840000191, "total_s": 2.431345800003328, "n_gen": 256, "n_chunks": 256, "tg": 125.68892316816523, "pp": 84.51043107246718}}
