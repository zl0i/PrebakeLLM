From 2793d9651d4d11b546c45411b222111d45dd4802 Mon Sep 17 00:00:00 2001
From: Claude Agent <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 15:11:28 +0300
Subject: [PATCH] CUDA mmvf: BF16 matrix x vector for short rows (ncols <=
 1024, <= 4 tokens, plain 2D): a group of 8/16/32 threads per row with 16-byte
 loads instead of one block per row with 4-byte loads (Qwen3.8
 hyper-connection 10240x320: 30.8 -> 17.7 us); GGML_CUDA_MMVF_SHORT=0 turns it
 off

---
 ggml/src/ggml-cuda/mmvf.cu | 86 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 86 insertions(+)

diff --git a/ggml/src/ggml-cuda/mmvf.cu b/ggml/src/ggml-cuda/mmvf.cu
index a62bf53e8..ffa5ff812 100644
--- a/ggml/src/ggml-cuda/mmvf.cu
+++ b/ggml/src/ggml-cuda/mmvf.cu
@@ -630,12 +630,98 @@ static void mul_mat_vec_f_cuda(
         stride_channel_dst, nsamples_x, nsamples_dst, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride, stream);
 }
 
+// moe-zc fork: BF16 matrix x vector for short rows (ncols <= 1024), e.g. the hyper-connection projections of
+// Qwen3.8 (10240 rows x 320). The generic kernel above runs one block per row with ncols/2 threads that load
+// 4 bytes each, which reached ~210 GB/s there. Here one warp computes one row with 16-byte loads, several rows
+// per block. Same fp32 accumulation; only the order of the additions differs.
+template <int ncols_dst, int lanes>
+static __global__ void k_mmvf_short_rows_bf16(
+        const nv_bfloat16 * __restrict__ x, const float * __restrict__ y, float * __restrict__ dst,
+        const int ncols, const int nrows, const int64_t stride_row, const int64_t stride_col_y, const int64_t stride_col_dst) {
+    // a group of `lanes` threads per row (8 for 320-value rows: 5 full 16-byte loads each, no idle lanes)
+    const int row  = blockIdx.x * (blockDim.x / lanes) + threadIdx.x / lanes;
+    const int lane = threadIdx.x % lanes;
+    const bool active = row < nrows;  // inactive lanes still take part in the shuffles below
+    const nv_bfloat16 * xr = x + (int64_t) (active ? row : 0) * stride_row;
+    float sum[ncols_dst] = {0.0f};
+    for (int c = lane * 8; active && c < ncols; c += lanes * 8) {
+        const uint4 w = *(const uint4 *) (xr + c);
+        const nv_bfloat162 * w2 = (const nv_bfloat162 *) &w;
+        float wf[8];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const float2 f = __bfloat1622float2(w2[i]);
+            wf[2*i + 0] = f.x;
+            wf[2*i + 1] = f.y;
+        }
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+            const float4 * yp = (const float4 *) (y + j * stride_col_y + c);
+            const float4 a = yp[0];
+            const float4 b = yp[1];
+            sum[j] += wf[0]*a.x + wf[1]*a.y + wf[2]*a.z + wf[3]*a.w + wf[4]*b.x + wf[5]*b.y + wf[6]*b.z + wf[7]*b.w;
+        }
+    }
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+        float v = sum[j];
+#pragma unroll
+        for (int off = lanes / 2; off > 0; off >>= 1) {
+            v += __shfl_xor_sync(0xffffffff, v, off, lanes);
+        }
+        if (active && lane == 0) {
+            dst[j * stride_col_dst + row] = v;
+        }
+    }
+}
+
+// returns false if the case is not handled (then the generic path runs)
+static bool mmvf_short_rows_bf16(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, const ggml_tensor * dst,
+        const ggml_cuda_mm_fusion_args_host * fusion, cudaStream_t stream) {
+    static const bool enabled = getenv("GGML_CUDA_MMVF_SHORT") == nullptr || atoi(getenv("GGML_CUDA_MMVF_SHORT")) != 0;
+    if (!enabled || ids || src0->type != GGML_TYPE_BF16) {
+        return false;
+    }
+    if (fusion && (fusion->gate || fusion->x_bias || fusion->gate_bias)) {
+        return false;
+    }
+    const int64_t ncols = src0->ne[0], nrows = src0->ne[1], ncols_dst = src1->ne[1];
+    if (ncols > 1024 || ncols % 8 != 0 || ncols_dst < 1 || ncols_dst > 4) {
+        return false;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || dst->ne[2] != 1 || dst->ne[3] != 1) {
+        return false;
+    }
+    const int64_t s01 = src0->nb[1] / sizeof(nv_bfloat16), s11 = src1->nb[1] / sizeof(float), s1 = dst->nb[1] / sizeof(float);
+    if (src0->nb[0] != sizeof(nv_bfloat16) || src1->nb[0] != sizeof(float) || s01 % 8 != 0 || (ncols_dst > 1 && s11 % 4 != 0) ||
+        (uintptr_t) src0->data % 16 != 0 || (uintptr_t) src1->data % 16 != 0) {
+        return false;
+    }
+    const int64_t chunks = ncols / 8;  // 16-byte loads per row
+    const int lanes = chunks % 32 == 0 ? 32 : chunks % 16 == 0 ? 16 : 8;
+    const int threads = 128;
+    const dim3 grid((nrows + threads / lanes - 1) / (threads / lanes)), block(threads);
+    const nv_bfloat16 * x = (const nv_bfloat16 *) src0->data;
+    const float * y = (const float *) src1->data;
+    float * d = (float *) dst->data;
+#define MMVF_SHORT(L)     switch (ncols_dst) {         case 1: k_mmvf_short_rows_bf16<1, L><<<grid, block, 0, stream>>>(x, y, d, ncols, nrows, s01, s11, s1); break;         case 2: k_mmvf_short_rows_bf16<2, L><<<grid, block, 0, stream>>>(x, y, d, ncols, nrows, s01, s11, s1); break;         case 3: k_mmvf_short_rows_bf16<3, L><<<grid, block, 0, stream>>>(x, y, d, ncols, nrows, s01, s11, s1); break;         case 4: k_mmvf_short_rows_bf16<4, L><<<grid, block, 0, stream>>>(x, y, d, ncols, nrows, s01, s11, s1); break;     }
+    if (lanes == 32)      { MMVF_SHORT(32) }
+    else if (lanes == 16) { MMVF_SHORT(16) }
+    else                  { MMVF_SHORT(8)  }
+#undef MMVF_SHORT
+    return true;
+}
+
 void ggml_cuda_mul_mat_vec_f(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst,
     const ggml_cuda_mm_fusion_args_host * fusion) {
     GGML_ASSERT(        src1->type == GGML_TYPE_F32);
     GGML_ASSERT(!ids ||  ids->type == GGML_TYPE_I32);
     GGML_ASSERT(         dst->type == GGML_TYPE_F32);
 
+    if (mmvf_short_rows_bf16(src0, src1, ids, dst, fusion, ctx.stream())) {
+        return;
+    }
+
     GGML_TENSOR_BINARY_OP_LOCALS;
 
     const size_t ts_src0 = ggml_type_size(src0->type);
-- 
