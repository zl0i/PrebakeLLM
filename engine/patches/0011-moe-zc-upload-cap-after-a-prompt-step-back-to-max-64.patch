From ce7fa0987de75af3572ae1819ecb5b36710199da Mon Sep 17 00:00:00 2001
From: Claude Agent <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 14:36:38 +0300
Subject: [PATCH] moe-zc: upload cap after a prompt step back to max(64, 16 x
 tokens) as before 0010 (1024 queued ~1.3 GB that the first decode step waited
 for: +30 ms time to first token on short prompts)

---
 ggml/src/ggml-cuda/moe-zc.cu | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/moe-zc.cu b/ggml/src/ggml-cuda/moe-zc.cu
index 68db76f78..129dcceb6 100644
--- a/ggml/src/ggml-cuda/moe-zc.cu
+++ b/ggml/src/ggml-cuda/moe-zc.cu
@@ -948,7 +948,9 @@ void ggml_cuda_moe_zc_observe(ggml_cuda_moe_zc * m, const int32_t * ids, int n_t
         } else {
             std::sort(misses.begin(), misses.end());
         }
-        const int max_up = n_tokens > ZC_MAX_TOKENS ? std::max(m->max_uploads_per_step, 16 * n_tokens) : m->up_budget;
+        // after a prompt step: as before 0010 (a larger cap there queued ~1.3 GB of copies that the first decode
+        // step waited for: +30 ms to the time to first token on short prompts)
+        const int max_up = n_tokens > ZC_MAX_TOKENS ? std::max(64, 16 * n_tokens) : m->up_budget;
         const int want = std::min((int) misses.size(), max_up);
         while ((int) m->free_slots.size() < std::max(want, m->reserve_slots)) {
             if (!zc_evict_one(m)) break;
-- 
