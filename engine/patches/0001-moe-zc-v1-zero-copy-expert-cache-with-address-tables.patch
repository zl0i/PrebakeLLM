@@ -1005,6 +1015,27 @@ static const ggml_backend_buffer_i ggml_backend_cuda_buffer_interface = {
     /* .cpy_tensor_n    = */ ggml_backend_cuda_buffer_cpy_tensor_n,
 };
 
+// [moe-zc] A CUDA buffer that wraps existing host memory. The memory is pinned (registered if
+// needed) and mapped into the GPU address space, so CUDA kernels read it directly over PCIe
+// ("zero-copy"). The scheduler treats tensors in this buffer as GPU tensors: ops using them run
+// on the GPU with no copies and no CPU<->GPU synchronization.
+ggml_backend_buffer_t ggml_backend_cuda_buffer_from_host_ptr(int device, void * ptr, size_t size) {
+    ggml_cuda_set_device(device);
+    void * registered = nullptr;
+    void * dev_ptr = nullptr;
+    if (cudaHostGetDevicePointer(&dev_ptr, ptr, 0) != cudaSuccess) {
+        (void) cudaGetLastError();
+        CUDA_CHECK(cudaHostRegister(ptr, size, cudaHostRegisterMapped | cudaHostRegisterPortable));
+        registered = ptr;
+        CUDA_CHECK(cudaHostGetDevicePointer(&dev_ptr, ptr, 0));
+    }
+    GGML_ASSERT(dev_ptr == ptr && "moe-zc: requires unified virtual addressing (device pointer == host pointer)");
+    auto * ctx = new ggml_backend_cuda_buffer_context(device, dev_ptr);
+    ctx->owns_memory = false;
+    ctx->host_registered = registered;
+    return ggml_backend_buffer_init(ggml_backend_cuda_buffer_type(device), ggml_backend_cuda_buffer_interface, ctx, size);
+}
+
