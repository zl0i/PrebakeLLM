+#pragma once
+
+// zero-copy MoE expert cache, see llama-moe-zc.cpp
+
+#include "ggml-backend.h"
+
+#include <vector>
+
+struct llama_model;
+
+// max tokens per step whose expert ids are observed (decode + speculative verification)
+#define LLAMA_MOE_ZC_MAX_TOKENS 8
+
+void llama_moe_zc_attach(llama_model & model);
+void llama_moe_zc_detach(llama_model & model);
+void llama_moe_zc_after_compute(const llama_model & model, ggml_backend_sched_t sched, const std::vector<int> & layers, int n_tokens);
