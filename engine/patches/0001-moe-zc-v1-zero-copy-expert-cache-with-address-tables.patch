diff --git a/src/llama-moe-zc.cpp b/src/llama-moe-zc.cpp
new file mode 100644
index 000000000..a6b832fe3
--- /dev/null
+++ b/src/llama-moe-zc.cpp
@@ -0,0 +1,168 @@
+// llama side of the zero-copy MoE expert cache (ai "LLM compiler" fork).
+// The CUDA side (VRAM slots, address tables, background uploads) is in
+// ggml/src/ggml-cuda/moe-zc.cu; this file wires it into a loaded model.
+//
+// Enabled by the environment variable LLAMA_MOE_ZC_MIB=<VRAM MiB for expert slots>,
+// together with expert weights kept in host RAM (-cmoe / -ncmoe) and no CPU repacking
+// (--repack 0 / --no-repack).
+//
+// What happens:
+//  1. after the weights are loaded, every host buffer that holds expert weights is
+//     wrapped into a CUDA buffer (the same memory, pinned and mapped for the GPU).
+//     The expert tensors are moved to that wrapper, so the scheduler runs their
+//     matrix multiplications on the GPU, reading RAM over PCIe when needed;
+//  2. a manager with N VRAM slots is created and all expert tensors are registered;
+//  3. every MoE layer copies its selected expert ids into a small VRAM tensor
+//     (llama-graph.cpp), and after each decode step (<= 8 tokens) the ids are
+//     handed to the manager (llama-context.cpp), which updates the cache in the
+//     background.
+
+#include "llama-moe-zc.h"
+
+#include "llama-impl.h"
+#include "llama-model.h"
+
+#include "ggml-backend.h"
+
+#include <cstdlib>
+#include <map>
+#include <set>
+
+typedef ggml_backend_buffer_t (*fn_from_host_t)(int, void *, size_t);
+typedef struct ggml_cuda_moe_zc * (*fn_create_t)(int, int, int, size_t, int);
+typedef void (*fn_add_t)(struct ggml_cuda_moe_zc *, int, const ggml_tensor *);
+typedef void (*fn_observe_t)(struct ggml_cuda_moe_zc *, const int32_t *, int, int);
+typedef void (*fn_free_t)(struct ggml_cuda_moe_zc *);
+
+static void * zc_proc(const char * name) {
+    ggml_backend_reg_t reg = ggml_backend_reg_by_name("CUDA");
+    return reg ? ggml_backend_reg_get_proc_address(reg, name) : nullptr;
+}
+
+void llama_moe_zc_attach(llama_model & model) {
+    const char * env = getenv("LLAMA_MOE_ZC_MIB");
+    if (!env) {
+        return;
+    }
+    const double mib = atof(env);
+
+    auto from_host = (fn_from_host_t) zc_proc("ggml_backend_cuda_buffer_from_host_ptr");
+    auto create    = (fn_create_t)    zc_proc("ggml_cuda_moe_zc_create");
+    auto add       = (fn_add_t)       zc_proc("ggml_cuda_moe_zc_add_tensor");
+    if (!from_host || !create || !add) {
+        LLAMA_LOG_WARN("%s: CUDA backend without moe-zc support, disabled\n", __func__);
+        return;
+    }
+
+    const int n_layer  = (int) model.layers.size();
+    const int n_expert = (int) model.hparams.n_expert;
+    const int n_used   = (int) model.hparams.n_expert_used_max();
+    if (n_expert <= 0) {
+        return;
+    }
+
+    // collect expert tensors per layer and check they are plain host memory
+    std::vector<std::vector<ggml_tensor *>> per_layer(n_layer);
+    size_t slot_bytes = 0;
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & l = model.layers[il];
+        size_t bytes = 0;
+        for (ggml_tensor * t : { l.ffn_gate_exps, l.ffn_up_exps, l.ffn_down_exps, l.ffn_gate_up_exps }) {
+            if (t == nullptr) {
+                continue;
+            }
+            if (!t->buffer || !ggml_backend_buffer_is_host(t->buffer)) {
+                LLAMA_LOG_WARN("%s: expert tensor %s is not in host memory (use -cmoe), moe-zc disabled\n", __func__, t->name);
+                return;
+            }
+            const std::string bname = ggml_backend_buffer_name(t->buffer);
+            if (bname.find("REPACK") != std::string::npos) {
+                LLAMA_LOG_WARN("%s: expert tensor %s is repacked for the CPU (use --repack 0), moe-zc disabled\n", __func__, t->name);
+                return;
+            }
+            per_layer[il].push_back(t);
+            bytes += GGML_PAD(ggml_row_size(t->type, t->ne[0]) * t->ne[1], 256);
+        }
+        slot_bytes = std::max(slot_bytes, bytes);
+    }
+
+    // 1. wrap host buffers so the GPU executes the expert matmuls (zero-copy reads)
+    std::map<ggml_backend_buffer_t, ggml_backend_buffer_t> wrapped;
+    for (auto & ts : per_layer) {
+        for (ggml_tensor * t : ts) {
+            if (wrapped.count(t->buffer) == 0) {
+                ggml_backend_buffer_t w = from_host(0, ggml_backend_buffer_get_base(t->buffer), ggml_backend_buffer_get_size(t->buffer));
+                wrapped[t->buffer] = w;
+                model.moe_zc_bufs.push_back(w);
+                LLAMA_LOG_INFO("%s: host buffer %s (%.2f MiB) mapped for zero-copy GPU access\n", __func__,
+                    ggml_backend_buffer_name(t->buffer), ggml_backend_buffer_get_size(t->buffer) / 1048576.0);
+            }
+            t->buffer = wrapped[t->buffer];
+        }
+    }
+
+    // 2. the manager with its VRAM slots
+    const int n_slots = (int) (mib * 1048576.0 / GGML_PAD(slot_bytes, 256));
+    model.moe_zc = create(0, n_layer, n_expert, slot_bytes, n_slots);
+    for (int il = 0; il < n_layer; ++il) {
+        for (ggml_tensor * t : per_layer[il]) {
+            add(model.moe_zc, il, t);
+        }
+    }
+
+    // 3. VRAM tensor that receives the selected expert ids of each layer: [n_used, 8 tokens, n_layer]
+    ggml_init_params ip = { ggml_tensor_overhead() * 2, nullptr, true };
+    model.moe_zc_ctx = ggml_init(ip);
+    model.moe_zc_ids = ggml_new_tensor_3d(model.moe_zc_ctx, GGML_TYPE_I32, n_used, LLAMA_MOE_ZC_MAX_TOKENS, n_layer);
+    ggml_set_name(model.moe_zc_ids, "moe_zc_ids");
+    ggml_backend_dev_t gpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    ggml_backend_buffer_t ids_buf = ggml_backend_alloc_ctx_tensors_from_buft(model.moe_zc_ctx, ggml_backend_dev_buffer_type(gpu));
+    model.moe_zc_bufs.push_back(ids_buf);
+
+    LLAMA_LOG_INFO("%s: zero-copy expert cache on: %d layers, slot %.2f MiB, %d slots\n", __func__,
+        n_layer, slot_bytes / 1048576.0, n_slots);
+}
+
+void llama_moe_zc_detach(llama_model & model) {
+    if (model.moe_zc) {
+        auto fr = (fn_free_t) zc_proc("ggml_cuda_moe_zc_free");
+        if (fr) {
+            fr(model.moe_zc);
+        }
+        model.moe_zc = nullptr;
+    }
+    for (auto b : model.moe_zc_bufs) {
+        ggml_backend_buffer_free(b);
+    }
+    model.moe_zc_bufs.clear();
+    if (model.moe_zc_ctx) {
+        ggml_free(model.moe_zc_ctx);
+        model.moe_zc_ctx = nullptr;
+    }
+}
+
+void llama_moe_zc_after_compute(const llama_model & model, ggml_backend_sched_t sched, const std::vector<int> & layers, int n_tokens) {
+    if (!model.moe_zc || layers.empty() || n_tokens > LLAMA_MOE_ZC_MAX_TOKENS) {
+        return;
+    }
+    static fn_observe_t observe = (fn_observe_t) zc_proc("ggml_cuda_moe_zc_observe");
+    const ggml_tensor * t = model.moe_zc_ids;
+    const int n_used  = (int) t->ne[0];
+    const int n_layer = (int) t->ne[2];
+
+    ggml_backend_sched_synchronize(sched);
+    std::vector<int32_t> raw(ggml_nelements(t));
+    ggml_backend_tensor_get(t, raw.data(), 0, ggml_nbytes(t));
+
+    // reorder [layer][token][k] -> [token][layer][k], layers not computed in this graph = -1
+    std::vector<int32_t> ids((size_t) n_tokens * n_layer * n_used, -1);
+    for (int il : layers) {
+        if (il < 0 || il >= n_layer) continue;
+        for (int tok = 0; tok < n_tokens; ++tok) {
+            for (int k = 0; k < n_used; ++k) {
+                ids[((size_t) tok * n_layer + il) * n_used + k] = raw[((size_t) il * LLAMA_MOE_ZC_MAX_TOKENS + tok) * n_used + k];
+            }
+        }
+    }
+    observe(model.moe_zc, ids.data(), n_tokens, n_used);
+}
