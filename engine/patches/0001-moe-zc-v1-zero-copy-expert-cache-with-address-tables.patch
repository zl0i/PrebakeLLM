diff --git a/ggml/src/ggml-cuda/moe-zc.cu b/ggml/src/ggml-cuda/moe-zc.cu
new file mode 100644
index 000000000..a58befce7
--- /dev/null
+++ b/ggml/src/ggml-cuda/moe-zc.cu
@@ -0,0 +1,387 @@
+// moe-zc: "zero-copy" expert cache for MoE models that do not fit in VRAM.
+// Part of the ai "LLM compiler" project (fork of llama.cpp, MIT).
+//
+// The idea in plain words
+// -----------------------
+// All expert weights stay in pinned (page-locked) host RAM. The GPU can read
+// that memory directly over PCIe ("zero-copy"), so every expert is always
+// usable by a GPU kernel without any copy and without asking the CPU.
+//
+// Reading over PCIe is ~20x slower than reading VRAM, so the experts that are
+// used often *right now* get a copy in a VRAM "slot". For every expert weight
+// tensor we keep a small table in GPU memory: table[e] = where expert e is
+// read from (its VRAM slot, or its place in host RAM). The matrix-vector
+// kernel (mmvq.cu) looks the address up in this table.
+//
+// Which experts deserve a slot is decided on the CPU, after each generated
+// token, from the experts that token used (every miss is copied in; the
+// victim is chosen by recency and frequency, see zc_crf). New copies are uploaded on a separate CUDA stream while the GPU is
+// already computing the next token, so the CPU never sits on the critical
+// path of a token. This replaces llama.cpp's --moe-cache-mib, which stops the
+// GPU in every layer to ask the CPU which experts to upload.
+//
+// Safety rules (the GPU may read the tables at any moment):
+//  * a table entry always points to valid data: first the data is uploaded,
+//    then (later on the same stream) the table entry is changed;
+//  * an evicted slot is not overwritten until the token that might still be
+//    reading it through an old table entry has finished ("quarantine").
+
+#include "common.cuh"
+#include "ggml-cuda.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cmath>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+// ------------------------------------------------------------------ registry
+// weight tensor data pointer -> device table of per-expert base pointers.
+// Read by mmvq.cu when it launches a MUL_MAT_ID kernel.
+
+static std::mutex g_zc_mutex;
+static std::unordered_map<const void *, const void * const *> g_zc_tables;
+
+const void * const * ggml_cuda_get_expert_table(const void * data) {
+    std::lock_guard<std::mutex> lock(g_zc_mutex);
+    if (g_zc_tables.empty()) {
+        return nullptr;
+    }
+    auto it = g_zc_tables.find(data);
+    return it == g_zc_tables.end() ? nullptr : it->second;
+}
+
+// ------------------------------------------------------------------ manager
+
+struct zc_tensor {
+    const ggml_tensor * t;
+    int    layer;
+    int    part;          // position inside the slot: 0,1,2 = order of registration within the layer
+    size_t expert_bytes;  // bytes of one expert in this tensor
+    size_t expert_stride; // nb[2]
+    size_t slot_offset;   // where this part of the expert lives inside a slot
+};
+
+// Replacement policy: CRF classes, adapted from llama.cpp src/llama-moe-cache.cpp
+// (moe_cache_lru, MIT). CRF ("combined recency and frequency") = number of uses of an
+// expert, decaying with a half-life of 128 tokens, kept even after eviction. Slots are
+// kept in one LRU list per class = floor(log2(CRF)); the victim is the least recently
+// used slot of the list with the largest age / 2^class. Frequently used experts thus
+// survive short pauses, rarely used ones leave first.
+struct zc_crf {
+    static constexpr int   n_class   = 8;
+    static constexpr float half_life = 128.0f; // tokens
+
+    std::vector<int32_t> prev, next;      // [slot] doubly linked lists, -1 at the ends
+    std::vector<int8_t>  list_of;         // [slot] class list, -1 if not in a list (free/quarantined)
+    int32_t head[n_class], tail[n_class]; // head = least recently used
+    std::vector<float>   crf;             // [key]
+    std::vector<int64_t> last_use;        // [key] clock at last use
+    int64_t clock = 0;                    // tokens seen
+
+    void init(int n_slots, int n_keys) {
+        prev.assign(n_slots, -1);
+        next.assign(n_slots, -1);
+        list_of.assign(n_slots, -1);
+        for (int c = 0; c < n_class; ++c) { head[c] = tail[c] = -1; }
+        crf.assign(n_keys, 0.0f);
+        last_use.assign(n_keys, 0);
+    }
+    float decayed(int key) const { return crf[key] * std::exp2(-(clock - last_use[key]) / half_life); }
+    void use(int key) { crf[key] = decayed(key) + 1.0f; last_use[key] = clock; }
+    int class_of(int key) const { return std::min(n_class - 1, (int) std::log2(std::max(1.0f, crf[key]))); }
+    void unlink(int s) {
+        const int c = list_of[s];
+        if (c < 0) return;
+        if (prev[s] >= 0) next[prev[s]] = next[s]; else head[c] = next[s];
+        if (next[s] >= 0) prev[next[s]] = prev[s]; else tail[c] = prev[s];
+        prev[s] = next[s] = -1;
+        list_of[s] = -1;
+    }
+    void push(int s, int c) { // to the most recently used end of list c
+        unlink(s);
+        prev[s] = tail[c];
+        next[s] = -1;
+        if (tail[c] >= 0) next[tail[c]] = s; else head[c] = s;
+        tail[c] = s;
+        list_of[s] = c;
+    }
+};
+
+struct ggml_cuda_moe_zc {
+    int device;
+    int n_layer;
+    int n_expert;
+    int n_slots;
+    size_t slot_bytes;
+
+    int reserve_slots = 64;  // free + quarantined slots kept ready for the next step's misses
+    int max_uploads_per_step = 64;
+    bool verbose = false;
+
+    char * d_slots = nullptr;            // n_slots * slot_bytes in VRAM
+
+    std::vector<zc_tensor> tensors;
+    std::vector<std::vector<int>> layer_tensors; // layer -> indices into tensors
+
+    // tables: [tensor][expert] pointers, host mirror (pinned) + device copy
+    const void ** h_tables = nullptr;
+    const void ** d_tables = nullptr;
+    bool tables_ready = false;
+    bool tables_dirty = false;
+
+    cudaStream_t copy_stream = nullptr;
+    cudaEvent_t  copy_done   = nullptr;
+    bool         copy_pending = false;
+
+    // cache state
+    zc_crf policy;
+    std::vector<int> slot_of;            // key -> slot or -1   (key = layer*n_expert + expert)
+    std::vector<int> key_of_slot;        // slot -> key or -1
+    std::vector<int64_t> used_step;      // key -> last step that selected it (never evict those)
+    std::vector<int> free_slots;
+    std::vector<std::pair<int64_t, int>> quarantine; // (step when reusable, slot)
+    int64_t step = 0;
+
+    // statistics
+    int64_t st_hits = 0, st_misses = 0, st_uploads = 0, st_evictions = 0, st_steps = 0, st_tokens = 0, st_no_slot = 0;
+};
+
+static void zc_init_tables(ggml_cuda_moe_zc * m) {
+    const size_t n = m->tensors.size() * (size_t) m->n_expert;
+    CUDA_CHECK(cudaMallocHost((void **) &m->h_tables, n * sizeof(void *)));
+    CUDA_CHECK(cudaMalloc((void **) &m->d_tables, n * sizeof(void *)));
+    for (size_t ti = 0; ti < m->tensors.size(); ++ti) {
+        const zc_tensor & z = m->tensors[ti];
+        for (int e = 0; e < m->n_expert; ++e) {
+            m->h_tables[ti * m->n_expert + e] = (const char *) z.t->data + (size_t) e * z.expert_stride;
+        }
+    }
+    CUDA_CHECK(cudaMemcpy(m->d_tables, m->h_tables, n * sizeof(void *), cudaMemcpyHostToDevice));
+    std::lock_guard<std::mutex> lock(g_zc_mutex);
+    for (size_t ti = 0; ti < m->tensors.size(); ++ti) {
+        g_zc_tables[m->tensors[ti].t->data] = m->d_tables + ti * m->n_expert;
+    }
+    m->tables_ready = true;
+}
+
+static void zc_set_entry(ggml_cuda_moe_zc * m, int key, int slot) {
+    m->tables_dirty = true;
+    const int il = key / m->n_expert;
+    const int e  = key % m->n_expert;
+    for (int ti : m->layer_tensors[il]) {
+        const zc_tensor & z = m->tensors[ti];
+        m->h_tables[(size_t) ti * m->n_expert + e] = slot < 0
+            ? (const void *) ((const char *) z.t->data + (size_t) e * z.expert_stride)
+            : (const void *) (m->d_slots + (size_t) slot * m->slot_bytes + z.slot_offset);
+    }
+}
+
+// evict the CRF victim: least recently used slot of the class list with the largest age/2^class,
+// skipping experts selected in the current step
+static bool zc_evict_one(ggml_cuda_moe_zc * m) {
+    zc_crf & p = m->policy;
+    int best = -1;
+    double best_score = -1.0;
+    for (int c = 0; c < zc_crf::n_class; ++c) {
+        for (int s = p.head[c]; s >= 0; s = p.next[s]) {
+            const int key = m->key_of_slot[s];
+            if (m->used_step[key] == m->step) continue;
+            const double score = std::ldexp((double) (p.clock - p.last_use[key]), -c);
+            if (score > best_score) { best = s; best_score = score; }
+            break;
+        }
+    }
+    if (best < 0) return false;
+    const int key = m->key_of_slot[best];
+    p.unlink(best);
+    m->slot_of[key] = -1;
+    m->key_of_slot[best] = -1;
+    zc_set_entry(m, key, -1);
+    // the token computed next may still read this slot via the old table entry
+    m->quarantine.emplace_back(m->step + 1, best);
+    m->st_evictions++;
+    return true;
+}
+
+extern "C" {
+
+ggml_cuda_moe_zc * ggml_cuda_moe_zc_create(int device, int n_layer, int n_expert, size_t slot_bytes, int n_slots) {
+    ggml_cuda_set_device(device);
+    auto * m = new ggml_cuda_moe_zc();
+    m->device = device;
+    m->n_layer = n_layer;
+    m->n_expert = n_expert;
+    m->n_slots = n_slots;
+    m->slot_bytes = GGML_PAD(slot_bytes, 256);
+    m->layer_tensors.resize(n_layer);
+    if (const char * s = getenv("LLAMA_MOE_ZC_RESERVE"))     m->reserve_slots = atoi(s);
+    if (const char * s = getenv("LLAMA_MOE_ZC_MAX_UPLOADS")) m->max_uploads_per_step = atoi(s);
+    if (const char * s = getenv("LLAMA_MOE_ZC_VERBOSE"))     m->verbose = atoi(s) != 0;
+    if (n_slots > 0) {
+        CUDA_CHECK(cudaMalloc((void **) &m->d_slots, (size_t) n_slots * m->slot_bytes));
+    }
+    CUDA_CHECK(cudaStreamCreateWithFlags(&m->copy_stream, cudaStreamNonBlocking));
+    CUDA_CHECK(cudaEventCreateWithFlags(&m->copy_done, cudaEventDisableTiming));
+
+    const int n_keys = n_layer * n_expert;
+    m->slot_of.assign(n_keys, -1);
+    m->key_of_slot.assign(n_slots, -1);
+    m->used_step.assign(n_keys, -1);
+    m->policy.init(n_slots, n_keys);
+    for (int s = n_slots - 1; s >= 0; --s) {
+        m->free_slots.push_back(s);
+    }
+    GGML_LOG_INFO("%s: %d layers x %d experts, %d VRAM slots x %.2f MiB = %.2f MiB, CRF replacement, reserve %d\n",
+        __func__, n_layer, n_expert, n_slots, m->slot_bytes / 1048576.0, n_slots * m->slot_bytes / 1048576.0, m->reserve_slots);
+    return m;
+}
+
+// Registers one expert weight tensor (3D: [ne0, ne1, n_expert]) of a layer.
+// Its data must be readable by the GPU (pinned host memory or VRAM).
+// Parts of the same layer are packed one after another inside a slot.
+void ggml_cuda_moe_zc_add_tensor(ggml_cuda_moe_zc * m, int layer, const ggml_tensor * t) {
+    GGML_ASSERT(!m->tables_ready && "register all tensors before the first step");
+    GGML_ASSERT(layer >= 0 && layer < m->n_layer && t->ne[2] == m->n_expert);
+    zc_tensor z;
+    z.t = t;
+    z.layer = layer;
+    z.part = (int) m->layer_tensors[layer].size();
+    z.expert_stride = t->nb[2];
+    z.expert_bytes  = ggml_row_size(t->type, t->ne[0]) * t->ne[1];
+    size_t off = 0;
+    for (int ti : m->layer_tensors[layer]) {
+        off += GGML_PAD(m->tensors[ti].expert_bytes, 256);
+    }
+    z.slot_offset = off;
+    GGML_ASSERT(off + z.expert_bytes <= m->slot_bytes && "slot too small for the experts of this layer");
+    m->layer_tensors[layer].push_back((int) m->tensors.size());
+    m->tensors.push_back(z);
+}
+
+// Called after a decode step finished (GPU idle for this model), with the
+// experts selected in every layer: ids[token][layer][k] (-1 = layer not computed).
+// Updates the cache and starts background uploads; returns immediately.
+void ggml_cuda_moe_zc_observe(ggml_cuda_moe_zc * m, const int32_t * ids, int n_tokens, int n_used) {
+    ggml_cuda_set_device(m->device);
+    if (!m->tables_ready) {
+        zc_init_tables(m);
+    }
+    m->step++;
+    m->st_steps++;
+    m->st_tokens += n_tokens;
+    zc_crf & p = m->policy;
+
+    // 1. previous uploads + table writes must be finished before we touch the
+    //    host table mirror again or reuse quarantined slots (usually long done)
+    if (m->copy_pending) {
+        CUDA_CHECK(cudaEventSynchronize(m->copy_done));
+        m->copy_pending = false;
+    }
+    for (size_t i = 0; i < m->quarantine.size();) {
+        if (m->quarantine[i].first <= m->step) {
+            m->free_slots.push_back(m->quarantine[i].second);
+            m->quarantine[i] = m->quarantine.back();
+            m->quarantine.pop_back();
+        } else {
+            ++i;
+        }
+    }
+
+    // 2. distinct experts of this step: update CRF, refresh hits, collect misses
+    std::vector<int> misses;
+    for (int tok = 0; tok < n_tokens; ++tok) {
+        for (int il = 0; il < m->n_layer; ++il) {
+            for (int k = 0; k < n_used; ++k) {
+                const int e = ids[((size_t) tok * m->n_layer + il) * n_used + k];
+                if (e < 0 || e >= m->n_expert) continue;
+                const int key = il * m->n_expert + e;
+                if (m->slot_of[key] >= 0) m->st_hits++; else m->st_misses++;
+                if (m->used_step[key] == m->step) continue; // already handled in this step
+                m->used_step[key] = m->step;
+                p.use(key);
+                if (m->slot_of[key] >= 0) {
+                    p.push(m->slot_of[key], p.class_of(key));
+                } else {
+                    misses.push_back(key);
+                }
+            }
+        }
+    }
+    p.clock += n_tokens;
+    if (m->n_slots == 0) {
+        return;
+    }
+
+    // 3. every miss gets a free slot (if any) and is uploaded in the background;
+    //    consecutive keys tend to get consecutive slots
+    std::sort(misses.begin(), misses.end());
+    int uploads = 0;
+    for (int key : misses) {
+        if (uploads >= m->max_uploads_per_step || m->free_slots.empty()) {
+            m->st_no_slot++;
+            continue;
+        }
+        const int slot = m->free_slots.back();
+        m->free_slots.pop_back();
+        const int il = key / m->n_expert;
+        const int e  = key % m->n_expert;
+        for (int ti : m->layer_tensors[il]) {
+            const zc_tensor & z = m->tensors[ti];
+            CUDA_CHECK(cudaMemcpyAsync(m->d_slots + (size_t) slot * m->slot_bytes + z.slot_offset,
+                (const char *) z.t->data + (size_t) e * z.expert_stride, z.expert_bytes,
+                cudaMemcpyDefault, m->copy_stream));
+        }
+        m->slot_of[key] = slot;
+        m->key_of_slot[slot] = key;
+        p.push(slot, p.class_of(key));
+        zc_set_entry(m, key, slot);
+        uploads++;
+        m->st_uploads++;
+    }
+
+    // 4. keep slots ready for the next step: evict CRF victims into quarantine
+    while ((int) (m->free_slots.size() + m->quarantine.size()) < m->reserve_slots) {
+        if (!zc_evict_one(m)) break;
+    }
+
+    // 5. publish the table (after the data uploads on the same stream)
+    if (m->tables_dirty) {
+        m->tables_dirty = false;
+        const size_t n = m->tensors.size() * (size_t) m->n_expert;
+        CUDA_CHECK(cudaMemcpyAsync((void *) m->d_tables, m->h_tables, n * sizeof(void *), cudaMemcpyHostToDevice, m->copy_stream));
+        CUDA_CHECK(cudaEventRecord(m->copy_done, m->copy_stream));
+        m->copy_pending = true;
+    }
+
+    if (m->verbose && m->st_steps % 64 == 0) {
+        GGML_LOG_INFO("moe_zc: steps %lld tokens %lld | hit %.1f%% | misses/token %.1f | uploads/step %.1f | no-slot %lld\n",
+            (long long) m->st_steps, (long long) m->st_tokens,
+            100.0 * m->st_hits / std::max<int64_t>(1, m->st_hits + m->st_misses),
+            (double) m->st_misses / std::max<int64_t>(1, m->st_tokens), (double) m->st_uploads / m->st_steps,
+            (long long) m->st_no_slot);
+    }
+}
+
+void ggml_cuda_moe_zc_free(ggml_cuda_moe_zc * m) {
+    if (!m) return;
+    GGML_LOG_INFO("moe_zc: total steps %lld tokens %lld | hit %.2f%% | misses/token %.2f | uploads %lld (%.2f/step) | evictions %lld\n",
+        (long long) m->st_steps, (long long) m->st_tokens,
+        100.0 * m->st_hits / std::max<int64_t>(1, m->st_hits + m->st_misses),
+        (double) m->st_misses / std::max<int64_t>(1, m->st_tokens),
+        (long long) m->st_uploads, (double) m->st_uploads / std::max<int64_t>(1, m->st_steps), (long long) m->st_evictions);
+    {
+        std::lock_guard<std::mutex> lock(g_zc_mutex);
+        for (auto & z : m->tensors) g_zc_tables.erase(z.t->data);
+    }
+    if (m->copy_stream) { cudaStreamSynchronize(m->copy_stream); cudaStreamDestroy(m->copy_stream); }
+    if (m->copy_done) cudaEventDestroy(m->copy_done);
+    if (m->d_slots) cudaFree(m->d_slots);
+    if (m->d_tables) cudaFree((void *) m->d_tables);
+    if (m->h_tables) cudaFreeHost((void *) m->h_tables);
+    delete m;
+}
+
+} // extern "C"
