     if (strcmp(name, "ggml_backend_get_features") == 0) {
         return (void *)ggml_backend_cuda_get_features;
     }
+    // [moe-zc]
+    if (strcmp(name, "ggml_backend_cuda_buffer_from_host_ptr") == 0) {
+        return (void *)ggml_backend_cuda_buffer_from_host_ptr;
+    }
+    if (strcmp(name, "ggml_cuda_moe_zc_create") == 0) {
+        return (void *)ggml_cuda_moe_zc_create;
+    }
+    if (strcmp(name, "ggml_cuda_moe_zc_add_tensor") == 0) {
+        return (void *)ggml_cuda_moe_zc_add_tensor;
+    }
+    if (strcmp(name, "ggml_cuda_moe_zc_observe") == 0) {
+        return (void *)ggml_cuda_moe_zc_observe;
+    }
+    if (strcmp(name, "ggml_cuda_moe_zc_free") == 0) {
+        return (void *)ggml_cuda_moe_zc_free;
+    }
     return nullptr;
 }
 
