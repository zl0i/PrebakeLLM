@@ -777,8 +777,18 @@ struct ggml_backend_cuda_buffer_context {
         name(GGML_CUDA_NAME + std::to_string(device)) {
     }
 
+    // [moe-zc] a buffer may wrap memory it does not own (pinned host RAM read by the GPU, see
+    // ggml_backend_cuda_buffer_from_host_ptr): then it must not cudaFree it
+    bool owns_memory = true;
+    void * host_registered = nullptr;
+
     ~ggml_backend_cuda_buffer_context() {
-        CUDA_CHECK(cudaFree(dev_ptr));
+        if (owns_memory) {
