From d7980ebfea02d70013321a13775ea3797cb7d1ad Mon Sep 17 00:00:00 2001
From: Dmitri <d.popov@posteam.top>
Date: Sat, 7 Nov 2026 21:45:47 +0300
Subject: [PATCH 3/5] moe-zc: prompt processing on VRAM copies of the experts
 (gather kernel for small batches, cache-aware DMA batch for large)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/common.cuh |  1 +
 ggml/src/ggml-cuda/mmq.cu     | 27 ++++++++++++++++
 ggml/src/ggml-cuda/moe-zc.cu  | 58 ++++++++++++++++++++++++++++++++++-
 3 files changed, 85 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index ae0b76c66..d03655d95 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1613,6 +1613,7 @@ struct ggml_cuda_moe_zc;
 bool ggml_cuda_moe_zc_lookup(const void * data, ggml_cuda_moe_zc ** m, int * ti);
 const void * const * ggml_cuda_moe_zc_table(ggml_cuda_moe_zc * m, int ti);
 int  ggml_cuda_moe_zc_max_tokens();
+void ggml_cuda_moe_zc_to_vram(ggml_cuda_moe_zc * m, int ti, void * dst, const int32_t * ids, size_t ids_nb1, int n_tokens, cudaStream_t stream);
 void ggml_cuda_moe_zc_send(ggml_cuda_moe_zc * m, int ti, const float * x, size_t x_nb_token,
         const int32_t * ids, size_t ids_nb_token, int n_tokens, cudaStream_t stream);
 void ggml_cuda_moe_zc_recv(ggml_cuda_moe_zc * m, int ti, float * dst, size_t dst_nb1, size_t dst_nb2,
diff --git a/ggml/src/ggml-cuda/mmq.cu b/ggml/src/ggml-cuda/mmq.cu
index 367657508..02eeac315 100644
--- a/ggml/src/ggml-cuda/mmq.cu
+++ b/ggml/src/ggml-cuda/mmq.cu
@@ -168,6 +168,33 @@ void ggml_cuda_mul_mat_q(
     GGML_ASSERT(        dst->type  == GGML_TYPE_F32);
     GGML_ASSERT(!ids || ids->type  == GGML_TYPE_I32); // Optional, used for batched GGML_MUL_MAT_ID.
 
+    // [moe-zc] expert weights that live in host RAM (moe-zc.cu): for prompt processing (large batches)
+    // copy the whole tensor to VRAM in one DMA transfer and run on the copy, like llama.cpp does for
+    // weights kept in RAM. Reading them over PCIe tile by tile from the kernel would be several times slower.
+    ggml_tensor zc_src0, zc_gate;
+    ggml_cuda_mm_fusion_args_host zc_fusion;
+    ggml_cuda_pool_alloc<char> zc_buf0(ctx.pool()), zc_buf1(ctx.pool());
+    if (ids) {
+        ggml_cuda_moe_zc * zm = nullptr;
+        int zt = -1;
+        if (ggml_cuda_moe_zc_lookup(src0->data, &zm, &zt)) {
+            zc_buf0.alloc(ggml_nbytes(src0));
+            ggml_cuda_moe_zc_to_vram(zm, zt, zc_buf0.get(), (const int32_t *) ids->data, ids->nb[1], (int) ids->ne[1], ctx.stream());
+            zc_src0 = *src0;
+            zc_src0.data = zc_buf0.get();
+            src0 = &zc_src0;
+        }
+        if (fusion && fusion->gate && ggml_cuda_moe_zc_lookup(fusion->gate->data, &zm, &zt)) {
+            zc_buf1.alloc(ggml_nbytes(fusion->gate));
+            ggml_cuda_moe_zc_to_vram(zm, zt, zc_buf1.get(), (const int32_t *) ids->data, ids->nb[1], (int) ids->ne[1], ctx.stream());
+            zc_gate = *fusion->gate;
+            zc_gate.data = zc_buf1.get();
+            zc_fusion = *fusion;
+            zc_fusion.gate = &zc_gate;
+            fusion = &zc_fusion;
+        }
+    }
+
     // Fused gate/up/GLU: src0 is the up weight, dst the GLU output.
     const ggml_tensor * gate = fusion ? fusion->gate : nullptr;
     ggml_cuda_mm_fusion_args_device fusion_device = {};
diff --git a/ggml/src/ggml-cuda/moe-zc.cu b/ggml/src/ggml-cuda/moe-zc.cu
index d8cdcadfb..c41ca40a8 100644
--- a/ggml/src/ggml-cuda/moe-zc.cu
+++ b/ggml/src/ggml-cuda/moe-zc.cu
@@ -481,7 +481,63 @@ static __global__ void k_zc_recv(const zc_mailbox * b, const uint32_t * seq, con
     for (int i = threadIdx.x; i < n_embd; i += blockDim.x) d[i] = src[i];
 }
 
-// ------------------------------------------------------------------ hooks used by mmvq.cu
+// copies the experts used by a batch into dst (laid out like the original tensor),
+// from their VRAM slot when cached, otherwise straight from host RAM
+static __global__ void k_zc_gather(char * dst, const char * host, size_t stride, size_t bytes, const void * const * table,
+        const int32_t * ids, int n_used, int ids_stride, int n_tokens) {
+    const int e = blockIdx.x;
+    __shared__ int used;
+    if (threadIdx.x == 0) used = 0;
+    __syncthreads();
+    for (int i = threadIdx.x; i < n_tokens * n_used; i += blockDim.x) {
+        if (ids[(i / n_used) * ids_stride + i % n_used] == e) used = 1;
+    }
+    __syncthreads();
+    if (!used) return;
+    const int4 * src = (const int4 *) (table[e] ? (const char *) table[e] : host + (size_t) e * stride);
+    int4 * d = (int4 *) (dst + (size_t) e * stride);
+    const size_t n = bytes / 16;
+    for (size_t i = (size_t) blockIdx.y * blockDim.x + threadIdx.x; i < n; i += (size_t) gridDim.y * blockDim.x) d[i] = src[i];
+}
+
+// ------------------------------------------------------------------ hooks used by mmvq.cu / mmq.cu
+
+// Prompt processing (large batches) runs the expert matmuls on a VRAM copy of the weight tensor.
+// Small batches: copy only the experts the batch uses (a kernel, no CPU round trip).
+// Large batches: one DMA batch; cached experts are copied within VRAM, the rest over PCIe.
+void ggml_cuda_moe_zc_to_vram(ggml_cuda_moe_zc * m, int ti, void * dst, const int32_t * ids, size_t ids_nb1, int n_tokens, cudaStream_t stream) {
+    const zc_tensor & z = m->tensors[ti];
+    const void * const * table = ggml_cuda_moe_zc_table(m, ti);
+    GGML_ASSERT(z.expert_bytes % 16 == 0 && z.expert_stride % 16 == 0);
+    if (n_tokens <= 64) {
+        k_zc_gather<<<dim3(m->n_expert, 4), 256, 0, stream>>>((char *) dst, (const char *) z.t->data, z.expert_stride, z.expert_bytes,
+            table, ids, m->n_used, (int) (ids_nb1 / sizeof(int32_t)), n_tokens);
+        return;
+    }
+    std::vector<void *> dsts;
+    std::vector<const void *> srcs;
+    std::vector<size_t> sizes;
+    for (int e = 0; e < m->n_expert; ++e) {
+        const void * cached = m->h_tables[(size_t) ti * m->n_expert + e]; // published table (unchanged during a step)
+        const void * src = cached ? cached : (const void *) ((const char *) z.t->data + (size_t) e * z.expert_stride);
+        char * d = (char *) dst + (size_t) e * z.expert_stride;
+        // merge runs of consecutive host experts into one copy
+        if (!cached && !srcs.empty() && sizes.back() % z.expert_stride == 0 &&
+            (const char *) srcs.back() + sizes.back() == (const char *) src && (char *) dsts.back() + sizes.back() == d &&
+            !m->h_tables[(size_t) ti * m->n_expert + e - 1]) {
+            sizes.back() += z.expert_stride;
+            continue;
+        }
+        dsts.push_back(d);
+        srcs.push_back(src);
+        sizes.push_back(z.expert_stride);
+    }
+    cudaMemcpyAttributes attr = {};
+    attr.srcAccessOrder = cudaMemcpySrcAccessOrderStream;
+    size_t attr_idx = 0;
+    CUDA_CHECK(cudaMemcpyBatchAsync(dsts.data(), srcs.data(), sizes.data(), dsts.size(), &attr, &attr_idx, 1, stream));
+}
+
 
 bool ggml_cuda_moe_zc_lookup(const void * data, ggml_cuda_moe_zc ** m, int * ti) {
     std::lock_guard<std::mutex> lock(g_zc_mutex);
