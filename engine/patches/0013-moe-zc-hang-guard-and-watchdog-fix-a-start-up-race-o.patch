 }
 
-static void zc_pin_thread(int ith) {
 #ifdef _WIN32
-    // one thread per P-core (Intel hybrid: P-cores have the highest EfficiencyClass)
-    static std::vector<DWORD_PTR> pmask = [] {
-        std::vector<DWORD_PTR> res;
+// P-cores (Intel hybrid: the highest EfficiencyClass): the first logical processor of each, and all of their
+// logical processors
+struct zc_pcores { std::vector<DWORD_PTR> own; DWORD_PTR all = 0; };
+static const zc_pcores & zc_get_pcores() {
+    static const zc_pcores pc = [] {
+        zc_pcores res;
         DWORD len = 0;
         GetLogicalProcessorInformationEx(RelationProcessorCore, nullptr, &len);
         std::vector<char> buf(len);
@@ -380,14 +405,38 @@ static void zc_pin_thread(int ith) {
             auto * r = (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX) p;
             if (r->Processor.EfficiencyClass == maxe) {
                 KAFFINITY mk = r->Processor.GroupMask[0].Mask;
-                res.push_back(mk & (~mk + 1));
+                res.own.push_back(mk & (~mk + 1));
+                res.all |= mk;
             }
         }
         return res;
     }();
-    if (!pmask.empty()) {
-        SetThreadAffinityMask(GetCurrentThread(), pmask[ith % pmask.size()]);
+    return pc;
+}
+
+// hard: worker ith on the first logical processor of P-core ith only (one worker per core, the fastest:
+// -2.4% for soft on Qwen3.8, BENCHMARKS 2026-11-09). soft: any logical processor of the P-cores, its own
+// core as the ideal processor.
+static void zc_set_affinity(HANDLE h, int ith, bool soft) {
+    const zc_pcores & pc = zc_get_pcores();
+    if (pc.own.empty()) return;
+    const DWORD_PTR own = pc.own[ith % pc.own.size()];
+    if (!soft || !pc.all) {
+        SetThreadAffinityMask(h, own);
+        return;
     }
+    SetThreadAffinityMask(h, pc.all);
+    DWORD idx = 0;
+    while (!((own >> idx) & 1)) ++idx;
+    SetThreadIdealProcessor(h, idx);
+}
+#endif
+
+static void zc_pin_thread(int ith) {
+#ifdef _WIN32
+    // LLAMA_MOE_ZC_SOFT_PIN=1: soft affinity from the start (otherwise only after a hang, see zc_watchdog)
+    static const bool soft = getenv("LLAMA_MOE_ZC_SOFT_PIN") && atoi(getenv("LLAMA_MOE_ZC_SOFT_PIN")) != 0;
+    zc_set_affinity(GetCurrentThread(), ith, soft);
     SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
 #else
     GGML_UNUSED(ith);
@@ -429,6 +478,9 @@ static void zc_worker(ggml_cuda_moe_zc * m, int ith) {
                 if (req == seen[il]) continue;
                 any = true;
                 seen[il] = req;
+                m->leader_seen[il].store(req, std::memory_order_relaxed);
+                m->leader_layer.store(il, std::memory_order_relaxed);
+                m->leader_state.store(1, std::memory_order_relaxed);
                 m->last_work_ns.store(zc_now_ns(), std::memory_order_relaxed);
                 std::atomic_thread_fence(std::memory_order_acquire);
                 // collect the experts this step must compute on the CPU
@@ -462,21 +514,31 @@ static void zc_worker(ggml_cuda_moe_zc * m, int ith) {
                     m->st_cpu_jobs++;
                     m->st_cpu_experts += (int64_t) m->job_miss.size();
                     const auto t0 = std::chrono::steady_clock::now();
-                    m->job_gen.fetch_add(1, std::memory_order_release); // wake helpers
+                    m->leader_state.store(2, std::memory_order_relaxed);
+                    m->thr[0].gen.store(m->job_gen.fetch_add(1, std::memory_order_release) + 1, std::memory_order_relaxed); // wake helpers
                     zc_job_part(m, 0);
                     m->st_cpu_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count();
                 }
                 std::atomic_thread_fence(std::memory_order_release);
                 b->done = req;
+                m->leader_state.store(3, std::memory_order_relaxed);
             }
             if (!any) zc_idle_wait(m, spins);
         }
     } else {
-        uint32_t gen = m->job_gen.load();
+        // The first job is generation 1. Taking job_gen as read here as the baseline (as before) raced with the
+        // leader: a helper that started late (slow, loaded machine) after the first job was issued waited for
+        // the next generation, and the leader waited for it in the barrier forever, the GPU in k_zc_recv.
+        // The workers are created before any request can arrive, so the baseline is 0.
+        uint32_t gen = 0;
         while (!m->stop.load(std::memory_order_relaxed)) {
             const uint32_t g = m->job_gen.load(std::memory_order_acquire);
             if (g == gen) { zc_idle_wait(m, spins); continue; }
             gen = g;
+            m->thr[ith].gen.store(g, std::memory_order_relaxed);
+            // test of the watchdog: LLAMA_MOE_ZC_TEST_STALL_S=N makes helper 1 sleep N s once, before CPU job 200
+            static const int test_stall_s = getenv("LLAMA_MOE_ZC_TEST_STALL_S") ? atoi(getenv("LLAMA_MOE_ZC_TEST_STALL_S")) : 0;
+            if (test_stall_s > 0 && ith == 1 && g == 200) std::this_thread::sleep_for(std::chrono::seconds(test_stall_s));
             zc_job_part(m, ith);
         }
     }
@@ -528,6 +590,89 @@ static void zc_uploader(ggml_cuda_moe_zc * m) {
     }
 }
 
+// ------------------------------------------------------------------ watchdog
+
+static void zc_dump_state(ggml_cuda_moe_zc * m, const char * why, double stalled_s) {
+    fprintf(stderr, "moe_zc WATCHDOG: %s, no progress for %.1f s (step %lld, steps %lld, tokens %lld)\n",
+        why, stalled_s, (long long) m->step, (long long) m->st_steps, (long long) m->st_tokens);
+    int n_pending = 0;
+    for (int il = 0; il < m->n_layer; ++il) {
+        const zc_mailbox * b = m->mb(il);
+        const uint32_t req = b->req, done = b->done;
+        if (req != done) {
+            fprintf(stderr, "  layer %2d: request %u (n_tokens %u) done %u, leader took %u\n",
+                il, req, b->n_tokens, done, m->leader_seen[il].load(std::memory_order_relaxed));
+            n_pending++;
+        }
+    }
+    if (n_pending == 0) fprintf(stderr, "  no mailbox request pending (layer 0: request %u done %u)\n", m->mb(0)->req, m->mb(0)->done);
+    fprintf(stderr, "  leader: state %d (0 scan, 1 collect, 2 CPU job, 3 job done) layer %d | job_gen %u job_layer %d job_miss %zu | barrier count %u gen %u\n",
+        m->leader_state.load(), m->leader_layer.load(), m->job_gen.load(), m->job_layer, m->job_miss.size(),
+        m->barrier_count.load(), m->barrier_gen.load());
+    fprintf(stderr, "  workers (gen/phase; phase 0 idle, 1-3 job phase, 11-13 in barrier 1-3):");
+    for (int i = 0; i < m->n_threads; ++i) fprintf(stderr, " [%d] %u/%d", i, m->thr[i].gen.load(), m->thr[i].phase.load());
+    fprintf(stderr, "\n");
+    // the uploader's fields are guarded by up_mutex; do not block on it (the main thread may hold it while waiting)
+    bool locked = false;
+    for (int i = 0; i < 100 && !(locked = m->up_mutex.try_lock()); ++i) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    fprintf(stderr, "  uploader: %s busy %d has_work %d go %d list %zu | copy_pending %d | upload budget %d of %d\n",
+        locked ? "" : "(up_mutex held, values unlocked)", (int) m->up_busy, (int) m->up_has_work, (int) m->up_go, m->up_list.size(),
+        (int) m->copy_pending, m->up_budget, m->max_uploads_per_step);
+    if (locked) m->up_mutex.unlock();
+    const int ms = m->main_state.load();
+    fprintf(stderr, "  main thread: observe() state %d (0 outside, 1 waits for the uploader, 2 waits for the copies, 3 bookkeeping)%s\n",
+        ms, ms ? "" : " - outside: compute graph running or llama busy elsewhere");
+    fflush(stderr);
+}
+
+static void zc_watchdog(ggml_cuda_moe_zc * m) {
+    const int64_t limit = (int64_t) m->watchdog_s * 1000000000LL;
+    std::vector<uint32_t> pend(m->n_layer, 0);
+    std::vector<int64_t> since(m->n_layer, 0);
+    bool reported = false;
+    for (;;) {
+        {
+            std::unique_lock<std::mutex> lock(m->wd_mutex);
+            if (m->wd_cv.wait_for(lock, std::chrono::seconds(1), [m] { return m->stop.load(); })) return;
+        }
+        const int64_t now = zc_now_ns();
+        int64_t worst = 0, worst_mail = 0;
+        const char * why = nullptr;
+        for (int il = 0; il < m->n_layer; ++il) {
+            const zc_mailbox * b = m->mb(il);
+            const uint32_t req = b->req;
+            if (req == b->done) { pend[il] = 0; continue; }
+            if (pend[il] != req) { pend[il] = req; since[il] = now; continue; }
+            worst_mail = std::max(worst_mail, now - since[il]);
+            if (now - since[il] > worst) { worst = now - since[il]; why = "a CPU expert request is not answered"; }
+        }
+        const int ms = m->main_state.load();
+        if (ms != 0 && now - m->main_since_ns.load() > worst) { worst = now - m->main_since_ns.load(); why = "observe() does not return"; }
+#ifdef _WIN32
+        // Hang guard (DECISIONS D11a): a CPU job takes well under a millisecond. A request waiting a second or
+        // more means a worker does not get its processor: the thread waiting for the GPU in the CUDA driver
+        // runs at a higher dynamic priority (21 was seen) on the one logical processor the worker is pinned to,
+        // and spins there until the CPU job is done, which needs that worker. Let the workers run on any
+        // P-core from now on (soft affinity, ~2% slower) - this resolved the observed hang at once.
+        if (!m->soft_affinity && worst_mail > 1000000000LL) {
+            for (int i = 0; i < (int) m->workers.size(); ++i) {
+                zc_set_affinity((HANDLE) m->workers[i].native_handle(), i, true);
+            }
+            m->soft_affinity = true;
+            fprintf(stderr, "moe_zc: a CPU expert request waited %.1f s: a worker does not get its processor; "
+                "the workers may run on any P-core from now on (hang guard, DECISIONS D11a)\n", worst_mail / 1e9);
+            fflush(stderr);
+        }
+#endif
+        if (worst > limit) {
+            if (!reported) zc_dump_state(m, why, worst / 1e9);
+            reported = true;
+        } else {
+            reported = false;
+        }
+    }
+}
+
