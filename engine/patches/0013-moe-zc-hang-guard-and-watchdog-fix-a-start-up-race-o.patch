@@ -1004,6 +1158,7 @@ void ggml_cuda_moe_zc_observe(ggml_cuda_moe_zc * m, const int32_t * ids, int n_t
     const size_t n = m->tensors.size() * (size_t) m->n_expert;
     CUDA_CHECK(cudaMemcpy((void *) m->d_tables, m->h_tables, n * sizeof(void *), cudaMemcpyHostToDevice));
     std::atomic_thread_fence(std::memory_order_release);
+    m->main_state.store(0, std::memory_order_relaxed);
 
     if (m->verbose && m->st_steps % 64 == 0) {
         GGML_LOG_INFO("moe_zc: steps %lld tokens %lld | VRAM hit %.1f%% | CPU experts/token %.1f (%.1f us/expert) | uploads/step %.1f (budget %d, wait %.2f ms/step)\n",
@@ -1037,6 +1192,9 @@ void ggml_cuda_moe_zc_free(ggml_cuda_moe_zc * m) {
     for (auto & w : m->workers) w.join();
     m->up_cv.notify_all();
     if (m->uploader.joinable()) m->uploader.join();
+    { std::lock_guard<std::mutex> lock(m->wd_mutex); }
