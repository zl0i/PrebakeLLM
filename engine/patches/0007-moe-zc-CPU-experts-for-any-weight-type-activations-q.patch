+        act == 1 ? "GELU" : "SiLU", n_scaled, n_clamped);
     start(model.moe_zc, n_used); // before the first graph is captured
 
     LLAMA_LOG_INFO("%s: zero-copy expert cache on: %d layers, slot %.2f MiB, %d slots\n", __func__,
