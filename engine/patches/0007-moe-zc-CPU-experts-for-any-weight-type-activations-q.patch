-        m->tr_q8->from_float(m->h.data() + (size_t) mi * n_ff, m->hq.data() + (size_t) mi * m->hq_row, n_ff);
+        m->job_tr_h->from_float(m->h.data() + (size_t) mi * n_ff, m->hq.data() + (size_t) mi * m->hq_row, n_ff);
     }
     zc_barrier(m);
     // phase 3: down rows -> mailbox out[t][k][:]
@@ -407,9 +437,20 @@ static void zc_worker(ggml_cuda_moe_zc * m, int ith) {
                         }
                     }
