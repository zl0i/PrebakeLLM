From 2d6458b79ed53f07c71d5a21b85c82aab4897031 Mon Sep 17 00:00:00 2001
From: Claude Agent <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 01:03:13 +0300
Subject: [PATCH] moe-zc: CPU experts for any weight type (activations
 quantized to each tensor's vec_dot type), fused gate_up, GELU, per-expert
 gate/up scales, SwiGLU clamp; unsupported FFNs (biases, other activations)
 disable moe-zc

---
 ggml/include/ggml-cuda.h        |   6 ++
 ggml/src/ggml-cuda/ggml-cuda.cu |   6 ++
 ggml/src/ggml-cuda/moe-zc.cu    | 107 +++++++++++++++++++++++++-------
 src/llama-moe-zc.cpp            |  49 +++++++++++++++
 4 files changed, 145 insertions(+), 23 deletions(-)

diff --git a/ggml/include/ggml-cuda.h b/ggml/include/ggml-cuda.h
index 1158dfe5a..ee59ad1ec 100644
--- a/ggml/include/ggml-cuda.h
+++ b/ggml/include/ggml-cuda.h
@@ -49,6 +49,12 @@ GGML_BACKEND_API ggml_cuda_moe_zc * ggml_cuda_moe_zc_create(int device, int n_la
 GGML_BACKEND_API void ggml_cuda_moe_zc_add_tensor(ggml_cuda_moe_zc * m, int layer, int role, const struct ggml_tensor * t); // role: 0 gate, 1 up, 2 down, 3 gate_up
 GGML_BACKEND_API void ggml_cuda_moe_zc_start(ggml_cuda_moe_zc * m, int n_used);
 GGML_BACKEND_API void ggml_cuda_moe_zc_launched(ggml_cuda_moe_zc * m);
+// how the CPU computes an expert, to match the model's compute graph (call before ggml_cuda_moe_zc_start):
+// act: 0 = SiLU(gate) * up, 1 = GELU(gate) * up (tanh approximation, as ggml_geglu);
+// per layer: clamp > 0 clamps up to [-clamp, clamp] and SiLU(gate) to <= clamp;
+// gate_s / up_s: per-expert output scales of the gate and up projections (n_expert floats) or NULL
+GGML_BACKEND_API void ggml_cuda_moe_zc_set_act(ggml_cuda_moe_zc * m, int act);
+GGML_BACKEND_API void ggml_cuda_moe_zc_set_layer(ggml_cuda_moe_zc * m, int layer, float clamp, const float * gate_s, const float * up_s);
 GGML_BACKEND_API void ggml_cuda_moe_zc_observe(ggml_cuda_moe_zc * m, const int32_t * ids, int n_tokens, int n_used);
 GGML_BACKEND_API void ggml_cuda_moe_zc_free(ggml_cuda_moe_zc * m);
 
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 0d6cb46d4..b25326601 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -6613,6 +6613,12 @@ static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, con
     if (strcmp(name, "ggml_cuda_moe_zc_start") == 0) {
         return (void *)ggml_cuda_moe_zc_start;
     }
+    if (strcmp(name, "ggml_cuda_moe_zc_set_act") == 0) {
+        return (void *)ggml_cuda_moe_zc_set_act;
+    }
+    if (strcmp(name, "ggml_cuda_moe_zc_set_layer") == 0) {
+        return (void *)ggml_cuda_moe_zc_set_layer;
+    }
     if (strcmp(name, "ggml_cuda_moe_zc_launched") == 0) {
         return (void *)ggml_cuda_moe_zc_launched;
     }
