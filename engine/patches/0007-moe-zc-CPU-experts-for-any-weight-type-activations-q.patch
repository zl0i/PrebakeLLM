+typedef void (*fn_set_act_t)(struct ggml_cuda_moe_zc *, int);
+typedef void (*fn_set_layer_t)(struct ggml_cuda_moe_zc *, int, float, const float *, const float *);
 
 static void * zc_proc(const char * name) {
     ggml_backend_reg_t reg = ggml_backend_reg_by_name("CUDA");
@@ -63,6 +65,30 @@ void llama_moe_zc_attach(llama_model & model) {
         return;
     }
 
+    // the CPU computes whole experts itself, so it must know the FFN of the architecture:
+    // act(gate) * up with SiLU or GELU, optional per-expert scales of gate/up and SwiGLU clamping.
+    // Expert biases and other activations are not implemented: leave such models to plain llama.cpp.
+    int act = -1;
+    switch (model.arch) {
+        case LLM_ARCH_QWEN2MOE: case LLM_ARCH_QWEN3MOE: case LLM_ARCH_QWEN3NEXT: case LLM_ARCH_QWEN35MOE:
+        case LLM_ARCH_QWEN4EXP: case LLM_ARCH_DEEPSEEK2: case LLM_ARCH_GLM4_MOE:
+            act = 0; break;
+        case LLM_ARCH_GEMMA4:
+            act = 1; break;
+        default: break;
+    }
+    if (act < 0) {
+        LLAMA_LOG_WARN("%s: expert FFN of architecture %s is not supported by moe-zc, disabled\n", __func__, model.arch_name().c_str());
+        return;
+    }
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & l = model.layers[il];
+        if (l.ffn_gate_exps_b || l.ffn_up_exps_b || l.ffn_down_exps_b || l.ffn_gate_up_exps_b) {
+            LLAMA_LOG_WARN("%s: expert biases are not supported by moe-zc, disabled\n", __func__);
+            return;
+        }
+    }
+
     // collect expert tensors per layer and check they are plain host memory
     std::vector<std::vector<ggml_tensor *>> per_layer(n_layer);
     std::vector<std::vector<int>> roles(n_layer);
@@ -110,11 +136,34 @@ void llama_moe_zc_attach(llama_model & model) {
     // 2. the manager with its VRAM slots
     const int n_slots = (int) (mib * 1048576.0 / GGML_PAD(slot_bytes, 256));
     model.moe_zc = create(0, n_layer, n_expert, slot_bytes, n_slots);
+    auto set_act   = (fn_set_act_t)   zc_proc("ggml_cuda_moe_zc_set_act");
+    auto set_layer = (fn_set_layer_t) zc_proc("ggml_cuda_moe_zc_set_layer");
+    GGML_ASSERT(set_act && set_layer);
+    set_act(model.moe_zc, act);
+    int n_scaled = 0, n_clamped = 0;
     for (int il = 0; il < n_layer; ++il) {
