+    std::vector<char> xq2;           // x quantized for up when job_tr_x2 != nullptr
     // current job (filled by the leader)
     struct miss { int t, k, e; };
     std::vector<miss> job_miss;
@@ -281,15 +288,25 @@ static void zc_job_part(ggml_cuda_moe_zc * m, int ith) {
     const int nth = m->n_threads;
     const int il = m->job_layer;
     const int nm = (int) m->job_miss.size();
-    const zc_tensor & tg = m->tensors[m->layer_gate[il]];
-    const zc_tensor & tu = m->tensors[m->layer_up[il]];
+    const int n_ff = m->n_ff, n_embd = m->n_embd;
