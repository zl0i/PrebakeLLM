+void ggml_cuda_moe_zc_set_act(ggml_cuda_moe_zc * m, int act) {
+    GGML_ASSERT(!m->tables_ready && (act == 0 || act == 1));
+    m->act = act;
+}
+
+void ggml_cuda_moe_zc_set_layer(ggml_cuda_moe_zc * m, int layer, float clamp, const float * gate_s, const float * up_s) {
+    GGML_ASSERT(!m->tables_ready && layer >= 0 && layer < m->n_layer);
+    m->layer_clamp[layer] = clamp;
+    if (gate_s) m->scale_gate[layer].assign(gate_s, gate_s + m->n_expert);
+    if (up_s)   m->scale_up[layer].assign(up_s, up_s + m->n_expert);
+}
