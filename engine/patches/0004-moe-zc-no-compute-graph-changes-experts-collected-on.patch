-        selected_experts->ne[0] == model.moe_zc_ids->ne[0]) {
-        const int64_t n_cap = std::min<int64_t>(n_tokens, model.moe_zc_ids->ne[1]); // the last n_cap tokens
-        ggml_tensor * src = ggml_view_2d(ctx0, selected_experts, selected_experts->ne[0], n_cap,
-            selected_experts->nb[1], (n_tokens - n_cap) * selected_experts->nb[1]);
-        ggml_tensor * dst = ggml_view_2d(ctx0, model.moe_zc_ids, selected_experts->ne[0], n_cap,
-            model.moe_zc_ids->nb[1], il * model.moe_zc_ids->nb[2]);
-        ggml_build_forward_expand(gf, ggml_cpy(ctx0, src, dst));
-        res->moe_zc_layers.push_back(il);
-    }
-
     if (arch == LLM_ARCH_GROVEMOE && n_expert != hparams.n_expert) {
         // TODO: Use scalar div instead when/if implemented
         ggml_tensor * f_sel = ggml_cast(ctx0, selected_experts, GGML_TYPE_F32);
