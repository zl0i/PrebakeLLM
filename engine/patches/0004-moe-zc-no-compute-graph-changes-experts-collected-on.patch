+++ b/src/llama-moe-zc.h
@@ -8,14 +8,9 @@
 
 struct llama_model;
 
-// max tokens per step whose expert ids are observed; for larger batches (prompt processing) the last
-// LLAMA_MOE_ZC_MAX_TOKENS tokens are observed, which warms the VRAM cache before generation starts
-#define LLAMA_MOE_ZC_MAX_TOKENS 64
-// steps up to this many tokens run hybrid (GPU + CPU experts) and report their experts through the mailboxes
-#define LLAMA_MOE_ZC_HYBRID_TOKENS 4
 
 void llama_moe_zc_attach(llama_model & model);
 void llama_moe_zc_detach(llama_model & model);
-void llama_moe_zc_after_compute(const llama_model & model, ggml_backend_sched_t sched, const std::vector<int> & layers, int n_tokens);
+void llama_moe_zc_after_compute(const llama_model & model, ggml_backend_sched_t sched, int n_tokens);
 // a compute graph was launched: background uploads may start (they then overlap with the computation)
 void llama_moe_zc_launched(const llama_model & model);
