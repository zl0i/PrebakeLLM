From 9796af9b8e126a29fab928d1c32462981b89f465 Mon Sep 17 00:00:00 2001
From: Dmitri <d.popov@posteam.top>
Date: Sat, 7 Nov 2026 21:54:40 +0300
Subject: [PATCH 4/5] moe-zc: no compute graph changes (experts collected on
 the CUDA side), no CUDA graph replay of host-planned prefill copies; prefill
 now bit-identical to upstream

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/ggml-cuda.cu |  7 +++++
 ggml/src/ggml-cuda/moe-zc.cu    | 30 ++++++++++++++++++-
 src/llama-context.cpp           |  2 +-
 src/llama-graph.cpp             | 15 ----------
 src/llama-graph.h               |  3 --
 src/llama-model.h               |  2 --
 src/llama-moe-zc.cpp            | 51 +++++----------------------------
 src/llama-moe-zc.h              |  7 +----
 8 files changed, 45 insertions(+), 72 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index bfaf3ca81..0d6cb46d4 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3063,6 +3063,13 @@ static bool ggml_cuda_graph_check_compability(ggml_cgraph * cgraph) {
                     GGML_LOG_DEBUG("%s: disabling CUDA graphs due to unsupported node type\n", __func__);
                 }
             }
+            // [moe-zc] large batches copy host-resident experts to VRAM with copies planned on the host from
+            // the current cache state (moe-zc.cu, ggml_cuda_moe_zc_to_vram): a recorded graph would replay stale copies
+            ggml_cuda_moe_zc * zm = nullptr;
+            int zt = -1;
+            if (node->src[2] && node->src[2]->ne[1] > 64 && ggml_cuda_moe_zc_lookup(node->src[0]->data, &zm, &zt)) {
+                use_cuda_graph = false;
+            }
         }
 
         if (!use_cuda_graph) {
diff --git a/ggml/src/ggml-cuda/moe-zc.cu b/ggml/src/ggml-cuda/moe-zc.cu
index c41ca40a8..a46fa87aa 100644
--- a/ggml/src/ggml-cuda/moe-zc.cu
+++ b/ggml/src/ggml-cuda/moe-zc.cu
@@ -52,6 +52,7 @@
 #endif
 
 #define ZC_MAX_TOKENS 4   // must not exceed the mmvq MoE batch limit of the expert types (Q6_K: 4)
+#define ZC_PF_TOKENS  64  // prompt processing: experts of the last 64 tokens of a batch warm up the cache
 
 enum zc_role { ZC_GATE = 0, ZC_UP = 1, ZC_DOWN = 2, ZC_GATE_UP = 3 };
 
@@ -210,6 +211,8 @@ struct ggml_cuda_moe_zc {
     bool up_go = false;            // set when the next graph has been launched (see ggml_cuda_moe_zc_launched)
 
     std::vector<uint32_t> observed_req;  // per layer: last mailbox request seen by observe()
+    int32_t * h_pf_ids = nullptr;        // pinned [n_layer][ZC_PF_TOKENS][n_used]: experts of the last prompt tokens
+    std::vector<int> pf_n;               // per layer: tokens in h_pf_ids (set when the copy is enqueued)
     std::vector<int32_t>  step_ids;      // scratch: ids[token][layer][k] of the current step
 
     // statistics
@@ -507,6 +510,13 @@ static __global__ void k_zc_gather(char * dst, const char * host, size_t stride,
 // Large batches: one DMA batch; cached experts are copied within VRAM, the rest over PCIe.
 void ggml_cuda_moe_zc_to_vram(ggml_cuda_moe_zc * m, int ti, void * dst, const int32_t * ids, size_t ids_nb1, int n_tokens, cudaStream_t stream) {
     const zc_tensor & z = m->tensors[ti];
+    if (z.role == ZC_UP) {
+        // remember the experts of the last prompt tokens (read by observe() after the step)
+        const int n = std::min(n_tokens, ZC_PF_TOKENS);
+        CUDA_CHECK(cudaMemcpy2DAsync(m->h_pf_ids + (size_t) z.layer * ZC_PF_TOKENS * m->n_used, m->n_used * sizeof(int32_t),
+            (const char *) ids + (size_t) (n_tokens - n) * ids_nb1, ids_nb1, m->n_used * sizeof(int32_t), n, cudaMemcpyDeviceToHost, stream));
+        m->pf_n[z.layer] = n;
+    }
     const void * const * table = ggml_cuda_moe_zc_table(m, ti);
     GGML_ASSERT(z.expert_bytes % 16 == 0 && z.expert_stride % 16 == 0);
     if (n_tokens <= 64) {
@@ -625,6 +635,8 @@ static void zc_finalize(ggml_cuda_moe_zc * m) {
         }
     }
     m->observed_req.assign(m->n_layer, 0);
+    CUDA_CHECK(cudaMallocHost((void **) &m->h_pf_ids, sizeof(int32_t) * m->n_layer * ZC_PF_TOKENS * m->n_used));
+    m->pf_n.assign(m->n_layer, 0);
     ggml_cpu_init();
     for (int i = 0; i < m->n_threads; ++i) {
         m->workers.emplace_back(zc_worker, m, i);
@@ -702,7 +714,22 @@ void ggml_cuda_moe_zc_observe(ggml_cuda_moe_zc * m, const int32_t * ids, int n_t
     }
     // ids == nullptr: decode step (<= ZC_MAX_TOKENS tokens), read the experts from the mailboxes
     // of the layers that ran in this step (no copy in the compute graph needed)
-    if (ids == nullptr) {
+    if (ids == nullptr && n_tokens > ZC_MAX_TOKENS) {
+        // prompt processing step: experts of its last tokens, captured by ggml_cuda_moe_zc_to_vram
+        int nt = 0;
+        for (int il = 0; il < m->n_layer; ++il) nt = std::max(nt, m->pf_n[il]);
+        m->step_ids.assign((size_t) std::max(nt, 1) * m->n_layer * n_used, -1);
+        for (int il = 0; il < m->n_layer; ++il) {
+            for (int t = 0; t < m->pf_n[il]; ++t) {
+                for (int k = 0; k < n_used; ++k) {
+                    m->step_ids[((size_t) t * m->n_layer + il) * n_used + k] = m->h_pf_ids[((size_t) il * ZC_PF_TOKENS + t) * m->n_used + k];
+                }
+            }
+            m->pf_n[il] = 0;
+        }
+        ids = m->step_ids.data();
+        n_tokens = std::max(nt, 1);
+    } else if (ids == nullptr) {
         m->step_ids.assign((size_t) n_tokens * m->n_layer * n_used, -1);
         for (int il = 0; il < m->n_layer; ++il) {
             const zc_mailbox * b = m->mb(il);
@@ -856,6 +883,7 @@ void ggml_cuda_moe_zc_free(ggml_cuda_moe_zc * m) {
     if (m->d_tables) cudaFree((void *) m->d_tables);
     if (m->h_tables) cudaFreeHost((void *) m->h_tables);
     if (m->h_mail) cudaFreeHost(m->h_mail);
+    if (m->h_pf_ids) cudaFreeHost(m->h_pf_ids);
     if (m->d_seq) cudaFree(m->d_seq);
     delete m;
 }
