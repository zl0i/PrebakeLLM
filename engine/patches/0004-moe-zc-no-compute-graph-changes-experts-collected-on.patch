--- a/src/llama-moe-zc.cpp
+++ b/src/llama-moe-zc.cpp
@@ -12,10 +12,9 @@
 //     The expert tensors are moved to that wrapper, so the scheduler runs their
 //     matrix multiplications on the GPU, reading RAM over PCIe when needed;
 //  2. a manager with N VRAM slots is created and all expert tensors are registered;
