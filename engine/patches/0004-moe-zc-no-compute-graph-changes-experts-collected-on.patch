-    llama_moe_zc_after_compute(model, sched.get(), res->moe_zc_layers, (int) ubatch.n_tokens);
+    llama_moe_zc_after_compute(model, sched.get(), (int) ubatch.n_tokens);
 
     ret = GGML_STATUS_SUCCESS;
 
