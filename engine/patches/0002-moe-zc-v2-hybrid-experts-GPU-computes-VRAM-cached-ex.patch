+static void zc_uploader(ggml_cuda_moe_zc * m) {
+#ifdef _WIN32
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+#endif
+    ggml_cuda_set_device(m->device);
+    std::vector<std::pair<int, int>> work;
+    for (;;) {
+        {
+            std::unique_lock<std::mutex> lock(m->up_mutex);
+            // start only after the main thread launched the next token's graph: CUDA API calls from
+            // this thread would otherwise delay that launch (driver lock), serializing copy and compute
+            m->up_cv.wait(lock, [m] { return (m->up_has_work && m->up_go) || m->stop.load(); });
+            if (m->stop.load() && !m->up_has_work) return;
+            work.swap(m->up_list);
+            m->up_has_work = false;
+            m->up_go = false;
+        }
+        // all copies of the step in one driver call
+        std::vector<void *> dsts;
+        std::vector<const void *> srcs;
+        std::vector<size_t> sizes;
+        for (auto [key, slot] : work) {
+            const int il = key / m->n_expert, e = key % m->n_expert;
+            for (int ti : m->layer_tensors[il]) {
+                const zc_tensor & z = m->tensors[ti];
+                dsts.push_back(m->d_slots + (size_t) slot * m->slot_bytes + z.slot_offset);
+                srcs.push_back((const char *) z.t->data + (size_t) e * z.expert_stride);
+                sizes.push_back(z.expert_bytes);
+            }
+        }
+        if (!dsts.empty()) {
+            cudaMemcpyAttributes attr = {};
+            attr.srcAccessOrder = cudaMemcpySrcAccessOrderStream;
+            size_t attr_idx = 0;
+            CUDA_CHECK(cudaMemcpyBatchAsync(dsts.data(), srcs.data(), sizes.data(), dsts.size(), &attr, &attr_idx, 1, m->copy_stream));
+        }
+        CUDA_CHECK(cudaEventRecord(m->copy_done, m->copy_stream));
+        work.clear();
+        {
+            std::lock_guard<std::mutex> lock(m->up_mutex);
+            m->up_busy = false;
+        }
+        m->up_cv.notify_all();
+    }
+}
