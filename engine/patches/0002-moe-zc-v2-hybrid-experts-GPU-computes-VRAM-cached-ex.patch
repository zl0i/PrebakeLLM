+static void zc_pin_thread(int ith) {
+#ifdef _WIN32
+    // one thread per P-core (Intel hybrid: P-cores have the highest EfficiencyClass)
+    static std::vector<DWORD_PTR> pmask = [] {
+        std::vector<DWORD_PTR> res;
+        DWORD len = 0;
+        GetLogicalProcessorInformationEx(RelationProcessorCore, nullptr, &len);
+        std::vector<char> buf(len);
+        if (!GetLogicalProcessorInformationEx(RelationProcessorCore, (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX) buf.data(), &len)) return res;
+        BYTE maxe = 0;
+        for (char * p = buf.data(); p < buf.data() + len; p += ((PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX) p)->Size)
+            maxe = std::max(maxe, ((PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX) p)->Processor.EfficiencyClass);
+        for (char * p = buf.data(); p < buf.data() + len; p += ((PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX) p)->Size) {
+            auto * r = (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX) p;
+            if (r->Processor.EfficiencyClass == maxe) {
+                KAFFINITY mk = r->Processor.GroupMask[0].Mask;
+                res.push_back(mk & (~mk + 1));
+            }
+        }
+        return res;
+    }();
+    if (!pmask.empty()) {
+        SetThreadAffinityMask(GetCurrentThread(), pmask[ith % pmask.size()]);
+    }
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
+#else
+    GGML_UNUSED(ith);
+#endif
+}
+
+static void zc_worker(ggml_cuda_moe_zc * m, int ith) {
+    zc_pin_thread(ith);
+    if (ith == 0) {
+        // leader: watches the mailboxes of all layers
+        std::vector<uint32_t> seen(m->n_layer, 0);
+        while (!m->stop.load(std::memory_order_relaxed)) {
+            bool any = false;
+            for (int il = 0; il < m->n_layer; ++il) {
+                zc_mailbox * b = m->mb(il);
+                const uint32_t req = b->req;
+                if (req == seen[il]) continue;
+                any = true;
+                seen[il] = req;
+                std::atomic_thread_fence(std::memory_order_acquire);
+                // collect the experts this step must compute on the CPU
+                const int n_tokens = (int) b->n_tokens;
+                const int32_t * ids = m->mb_ids(il);
+                m->job_miss.clear();
+                for (int t = 0; t < n_tokens; ++t) {
+                    for (int k = 0; k < m->n_used; ++k) {
+                        const int e = ids[t * m->n_used + k];
+                        if (e >= 0 && e < m->n_expert && !m->published[il * m->n_expert + e]) {
+                            m->job_miss.push_back({ t, k, e });
+                        }
+                    }
+                }
+                if (!m->job_miss.empty() && m->layer_gate[il] >= 0) {
+                    for (int t = 0; t < n_tokens; ++t) {
+                        m->tr_q8->from_float(m->mb_x(il) + (size_t) t * m->n_embd, m->xq.data() + (size_t) t * m->xq_row, m->n_embd);
+                    }
+                    m->job_layer = il;
+                    m->st_cpu_jobs++;
+                    m->st_cpu_experts += (int64_t) m->job_miss.size();
+                    const auto t0 = std::chrono::steady_clock::now();
+                    m->job_gen.fetch_add(1, std::memory_order_release); // wake helpers
+                    zc_job_part(m, 0);
+                    m->st_cpu_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count();
+                }
+                std::atomic_thread_fence(std::memory_order_release);
+                b->done = req;
+            }
+            if (!any) _mm_pause();
+        }
+    } else {
+        uint32_t gen = m->job_gen.load();
+        while (!m->stop.load(std::memory_order_relaxed)) {
+            const uint32_t g = m->job_gen.load(std::memory_order_acquire);
+            if (g == gen) { _mm_pause(); continue; }
+            gen = g;
+            zc_job_part(m, ith);
+        }
+    }
+}
