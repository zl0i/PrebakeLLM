+static __global__ void k_zc_signal(zc_mailbox * b, uint32_t * seq, uint32_t n_tokens) {
+    const uint32_t s = ++(*seq);
+    b->n_tokens = n_tokens;
+    __threadfence_system();
+    b->req = s;
+    __threadfence_system();
+}
+
+// waits for the CPU, then copies the CPU experts' outputs into dst[:, k, t]
+static __global__ void k_zc_recv(const zc_mailbox * b, const uint32_t * seq, const float * out, const int32_t * ids,
+        int ids_stride, const void * const * table_down, float * dst, int dst_s1, int dst_s2, int n_embd, int n_used) {
+    const int k = blockIdx.x, t = blockIdx.y;
+    if (threadIdx.x == 0) {
+        const uint32_t s = *seq;
+        while (b->done < s) { }
+        __threadfence_system();
+    }
+    __syncthreads();
+    const int e = ids[t * ids_stride + k];
+    if (table_down[e] != nullptr) return;  // computed on the GPU
+    const float * src = out + ((size_t) t * n_used + k) * n_embd;
+    float * d = dst + (size_t) t * dst_s2 + (size_t) k * dst_s1;
+    for (int i = threadIdx.x; i < n_embd; i += blockDim.x) d[i] = src[i];
+}
