+static inline float zc_silu(float x) { return x / (1.0f + std::exp(-x)); }
+
+// all threads run this for one job (one layer, its CPU experts)
+static void zc_job_part(ggml_cuda_moe_zc * m, int ith) {
+    const int nth = m->n_threads;
+    const int il = m->job_layer;
+    const int nm = (int) m->job_miss.size();
+    const zc_tensor & tg = m->tensors[m->layer_gate[il]];
+    const zc_tensor & tu = m->tensors[m->layer_up[il]];
+    const zc_tensor & td = m->tensors[m->layer_down[il]];
+    const auto * trg = ggml_get_type_traits_cpu(tg.t->type);
+    const auto * tru = ggml_get_type_traits_cpu(tu.t->type);
+    const auto * trd = ggml_get_type_traits_cpu(td.t->type);
+    const int n_ff = m->n_ff, n_embd = m->n_embd;
+
+    // phase 1: gate and up rows of all CPU experts -> h = silu(gate) * up
+    {
+        const int total = nm * n_ff;
+        const int per = (total + nth - 1) / nth;
+        const int r0 = ith * per, r1 = std::min(total, r0 + per);
+        for (int r = r0; r < r1; ++r) {
+            const int mi = r / n_ff, row = r % n_ff;
+            const auto & ms = m->job_miss[mi];
+            const char * xq = m->xq.data() + (size_t) ms.t * m->xq_row;
+            float g, u;
+            trg->vec_dot(n_embd, &g, 0, (const char *) tg.t->data + (size_t) ms.e * tg.expert_stride + (size_t) row * tg.row_bytes, 0, xq, 0, 1);
+            tru->vec_dot(n_embd, &u, 0, (const char *) tu.t->data + (size_t) ms.e * tu.expert_stride + (size_t) row * tu.row_bytes, 0, xq, 0, 1);
+            m->h[(size_t) mi * n_ff + row] = zc_silu(g) * u;
+        }
+    }
+    zc_barrier(m);
+    // phase 2: quantize h of each expert for the down projection
+    for (int mi = ith; mi < nm; mi += nth) {
+        m->tr_q8->from_float(m->h.data() + (size_t) mi * n_ff, m->hq.data() + (size_t) mi * m->hq_row, n_ff);
+    }
+    zc_barrier(m);
+    // phase 3: down rows -> mailbox out[t][k][:]
+    {
+        const int total = nm * n_embd;
+        const int per = (total + nth - 1) / nth;
+        const int r0 = ith * per, r1 = std::min(total, r0 + per);
+        float * out = m->mb_out(il);
+        for (int r = r0; r < r1; ++r) {
+            const int mi = r / n_embd, row = r % n_embd;
+            const auto & ms = m->job_miss[mi];
+            float v;
+            trd->vec_dot(n_ff, &v, 0, (const char *) td.t->data + (size_t) ms.e * td.expert_stride + (size_t) row * td.row_bytes, 0,
+                m->hq.data() + (size_t) mi * m->hq_row, 0, 1);
+            out[((size_t) ms.t * m->n_used + ms.k) * n_embd + row] = v;
+        }
+    }
+    zc_barrier(m);
+}
