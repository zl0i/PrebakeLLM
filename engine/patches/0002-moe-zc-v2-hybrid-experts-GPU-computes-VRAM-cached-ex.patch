+    m->layer_up.assign(m->n_layer, -1);
+    m->layer_down.assign(m->n_layer, -1);
+    for (size_t ti = 0; ti < m->tensors.size(); ++ti) {
+        const zc_tensor & z = m->tensors[ti];
+        if (z.role == ZC_GATE) m->layer_gate[z.layer] = (int) ti;
+        if (z.role == ZC_UP)   m->layer_up[z.layer]   = (int) ti;
+        if (z.role == ZC_DOWN) m->layer_down[z.layer] = (int) ti;
+        if (z.role == ZC_DOWN) { m->n_ff = (int) z.t->ne[0]; m->n_embd = (int) z.t->ne[1]; }
+    }
+    m->tr_q8 = ggml_get_type_traits_cpu(GGML_TYPE_Q8_K);
+    m->xq_row = ggml_row_size(GGML_TYPE_Q8_K, m->n_embd);
+    m->hq_row = ggml_row_size(GGML_TYPE_Q8_K, m->n_ff);
+    m->xq.resize((size_t) ZC_MAX_TOKENS * m->xq_row);
+    m->h.resize((size_t) ZC_MAX_TOKENS * m->n_used * m->n_ff);
+    m->hq.resize((size_t) ZC_MAX_TOKENS * m->n_used * m->hq_row);
+
+    // mailboxes
+    m->mail_stride = GGML_PAD(sizeof(zc_mailbox) + sizeof(float) * ZC_MAX_TOKENS * m->n_embd + sizeof(int32_t) * ZC_MAX_TOKENS * m->n_used
